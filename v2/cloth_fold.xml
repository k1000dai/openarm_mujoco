<!--
Cloth folding task: a square piece of cloth lies flat on the table; the two
arms pinch its edge/corners and fold it over. The cloth is a MuJoCo flex
membrane (9x9 grid, ~0.16 m square) built with built-in edge constraints
(no external plugin). Self-collision is disabled for stability; folded layers
pass through each other.
-->

<mujoco model="openarm_bimanual cell cloth_fold">
  <visual>
    <global offwidth="960" offheight="600"/>
  </visual>

  <asset>
    <model name="cell" file="cell.xml"/>
  </asset>
  <worldbody>
    <attach model="cell" prefix=""/>

    <flexcomp name="cloth" type="grid" dim="2" count="9 9 1"
              spacing="0.02 0.02 0.02" pos="0.47 0 1.02" radius="0.003"
              mass="0.05" rgba="0.85 0.3 0.3 1">
      <edge equality="true" solref="0.005 1"/>
      <contact condim="3" solref="0.01 1" solimp="0.9 0.95 0.001"
               friction="1 0.05 0.001" selfcollide="none" internal="false"/>
    </flexcomp>
  </worldbody>

</mujoco>
