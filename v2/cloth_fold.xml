<!--
Cloth folding task: a square piece of cloth lies flat on the table; the two
arms pinch its edge/corners and fold it over. The cloth is a MuJoCo flex
membrane (13x13 grid, ~0.17 m square) built with built-in edge constraints
(no external plugin). A two-tone checker texture makes folds clearly visible,
and self-collision is enabled so folded layers stack on top of each other
instead of passing through. The 13x13 resolution keeps the scene real-time on
a typical CPU (physics is CPU-only; a GPU does not accelerate it) -- raise the
grid count if you target a faster machine and re-check the real-time factor.
-->

<mujoco model="openarm_bimanual cell cloth_fold">
  <visual>
    <global offwidth="960" offheight="600"/>
  </visual>

  <asset>
    <model name="cell" file="cell.xml"/>
    <texture type="2d" name="cloth_tex" builtin="checker" mark="edge"
             markrgb="0.9 0.9 0.9" rgb1="0.80 0.22 0.22" rgb2="0.93 0.78 0.40"
             width="300" height="300"/>
    <material name="cloth_mat" texture="cloth_tex" texrepeat="6 6"
              texuniform="true" reflectance="0.0"/>
  </asset>
  <worldbody>
    <attach model="cell" prefix=""/>

    <flexcomp name="cloth" type="grid" dim="2" count="13 13 1"
              spacing="0.014 0.014 0.014" pos="0.47 0 1.02" radius="0.0035"
              mass="0.05" material="cloth_mat">
      <edge equality="true" solref="0.005 1"/>
      <contact condim="3" solref="0.01 1" solimp="0.9 0.95 0.001"
               friction="1 0.05 0.001" selfcollide="auto" internal="false"/>
    </flexcomp>
  </worldbody>

</mujoco>
