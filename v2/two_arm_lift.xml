<!--
Two-arm lift task: a pot with a handle on each side must be lifted off the
table by both arms together while keeping it level. The geometry is built
from primitives (no external assets); the task concept follows robosuite's
TwoArmLift environment.
-->

<mujoco model="openarm_bimanual cell two_arm_lift">
  <visual>
    <global offwidth="960" offheight="600"/>
  </visual>

  <default>
    <default class="pot">
      <geom type="box" friction="1 0.5 0.01" contype="1" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <model name="cell" file="cell.xml"/>
  </asset>
  <worldbody>
    <attach model="cell" prefix=""/>

    <body name="pot" pos="0.46 0 1.05">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.002 0.002 0.003"/>

      <!-- tray: bottom plate + four low walls -->
      <geom name="pot_bottom" class="pot" pos="0 0 -0.025" size="0.05 0.06 0.005" rgba="0.6 0.6 0.65 1"/>
      <geom name="pot_wall_px" class="pot" pos="0.05 0 0"  size="0.006 0.06 0.025" rgba="0.6 0.6 0.65 1"/>
      <geom name="pot_wall_nx" class="pot" pos="-0.05 0 0" size="0.006 0.06 0.025" rgba="0.6 0.6 0.65 1"/>
      <geom name="pot_wall_py" class="pot" pos="0 0.06 0"  size="0.05 0.006 0.025" rgba="0.6 0.6 0.65 1"/>
      <geom name="pot_wall_ny" class="pot" pos="0 -0.06 0" size="0.05 0.006 0.025" rgba="0.6 0.6 0.65 1"/>

      <!-- left (+y) handle: basket handle with a central grasp opening -->
      <geom name="handle_l_arm1" class="pot" pos="0.025 0.09 0.02"  size="0.005 0.025 0.005" rgba="0.15 0.15 0.15 1"/>
      <geom name="handle_l_arm2" class="pot" pos="-0.025 0.09 0.02" size="0.005 0.025 0.005" rgba="0.15 0.15 0.15 1"/>
      <geom name="handle_l_bar"  class="pot" pos="0 0.115 0.02"     size="0.03 0.006 0.008"  rgba="0.15 0.15 0.15 1"/>

      <!-- right (-y) handle -->
      <geom name="handle_r_arm1" class="pot" pos="0.025 -0.09 0.02"  size="0.005 0.025 0.005" rgba="0.15 0.15 0.15 1"/>
      <geom name="handle_r_arm2" class="pot" pos="-0.025 -0.09 0.02" size="0.005 0.025 0.005" rgba="0.15 0.15 0.15 1"/>
      <geom name="handle_r_bar"  class="pot" pos="0 -0.115 0.02"     size="0.03 0.006 0.008"  rgba="0.15 0.15 0.15 1"/>
    </body>
  </worldbody>

</mujoco>
