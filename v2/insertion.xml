<mujoco model="openarm_bimanual cell insertion">
  <visual>
    <global offwidth="960" offheight="600"/>
  </visual>

  <default>
    <default class="insertion_object">
      <geom condim="4" solimp="0.9 0.95 0.002 0.5 2" solref="0.02 1" contype="1" conaffinity="1"/>
    </default>
  </default>

  <asset>
    <model name="cell" file="cell.xml"/>
  </asset>
  <worldbody>
    <attach model="cell" prefix=""/>

    <body name="peg" pos="0.45 -0.15 1.04">
      <freejoint/>
      <geom name="red_peg" class="insertion_object" type="box" size="0.06 0.01 0.01"
            mass="0.065" friction="1 0.005 0.0001" rgba="1 0 0 1"/>
    </body>

    <body name="socket" pos="0.45 0.15 1.05">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.008 0.008 0.008"/>
      <geom name="socket-1" class="insertion_object" type="box" pos="0 0 -0.02"
            size="0.06 0.022 0.002" friction="1 0.05 0.001" rgba="0 0 1 1"/>
      <geom name="socket-2" class="insertion_object" type="box" pos="0 0 0.02"
            size="0.06 0.022 0.002" friction="1 0.05 0.001" rgba="0 0 1 1"/>
      <geom name="socket-3" class="insertion_object" type="box" pos="0 0.02 0"
            size="0.06 0.002 0.018" friction="1 0.05 0.001" rgba="0 0 1 1"/>
      <geom name="socket-4" class="insertion_object" type="box" pos="0 -0.02 0"
            size="0.06 0.002 0.018" friction="1 0.05 0.001" rgba="0 0 1 1"/>
      <!-- closed back end: makes the socket a blind hole so the peg bottoms out -->
      <geom name="socket_back" class="insertion_object" type="box" pos="-0.06 0 0"
            size="0.002 0.022 0.022" friction="1 0.05 0.001" rgba="0 0 1 1"/>
    </body>
  </worldbody>

</mujoco>
